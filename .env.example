# ─── LLM API 키 설정 ───────────────────────────────────────────
# 사용하려는 LLM의 API 키를 아래에 입력하세요.
# 최소 하나 이상 설정하면 됩니다.

# OpenAI (https://platform.openai.com/api-keys)
OPENAI_API_KEY=

# Anthropic Claude (https://console.anthropic.com/settings/keys)
CLAUDE_API_KEY=
# 또는
# ANTHROPIC_API_KEY=

# Google Gemini (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=
# 또는
# GOOGLE_API_KEY=

# ─── 선택 옵션 ─────────────────────────────────────────────────
# LLM_MODEL=gpt-4o-mini        # 사용할 모델 (생략 시 provider별 기본값)
# LLM_MAX_TOKENS=1024           # 최대 출력 토큰
# LLM_TEMPERATURE=0.3           # 응답 온도 (0.0~1.0)
